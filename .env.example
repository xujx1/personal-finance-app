# Optional owner-only writes after sharing. Configure using the trusted Sites subject.
OWNER_SUBJECT_ID=
# Future model integration; not used by the first asset/ledger milestone.
NEW_API_BASE_URL=
NEW_API_MODEL=
NEW_API_KEY=
# Optional operator-only advisor daily attempts: integer1..50; empty/invalid defaults to10.
AI_ADVISOR_DAILY_LIMIT=
# Future encrypted backups. Never commit the actual key.
BACKUP_ACTIVE_KEY_ID=
BACKUP_KEYRING=

# Vision is explicit; do not assume the text model supports images.
NEW_API_VISION_MODEL=
# Optional research search service
TAVILY_API_KEY=
# Official ChatGPT OAuth; 32 random bytes in base64url, stored only in secure config.
CHATGPT_TOKEN_KEY=
CHATGPT_REDIRECT_URI=http://127.0.0.1:5173/auth/callback
# Hosted HTTPS callbacks require an eligible registered client.
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=

# Separate 32-byte base64url key; required only for explicitly saved receipts.
ATTACHMENT_KEY=
